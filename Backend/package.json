{
  "name": "dnssec-manager-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Modernized build (esbuild + sass + postcss) for ASP.NET Core static assets",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf wwwroot/css/* wwwroot/js/*",
    "build:css": "sass --no-error-css --source-map src/scss:wwwroot/css",
    "build:js": "node scripts/build-js.cjs",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "chokidar \"src/scss/**/*.scss\" -c \"npm run build:css\"",
    "watch:js": "chokidar \"src/js/**/*.js\" -c \"npm run build:js\"",
    "watch": "npm-run-all --parallel watch:css watch:js"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.10",
    "sass": "^1.81.0"
  }
}
