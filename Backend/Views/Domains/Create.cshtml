@model Backend.Models.Domain

@{
    ViewData["Title"] = "Add Domain";
}

<h1>Add Domain</h1>

<br/>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label">Domain Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DnsServerId" class="control-label">Choose DNS Server</label>
                <select asp-for="DnsServerId" class="form-control" asp-items="ViewBag.DnsServerId">
                    <option value="">Domain not connected</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Add Domain" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<br/>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
